# Copy to .env and edit. Docker Compose reads .env automatically.
# .env is gitignored; never commit it.

# --- Where the stack listens ---
# Every published port binds to this address and no other. On the host, set it to the host's VPN
# (Tailscale) address, <TAILSCALE_ADDRESS>, so nothing answers from off the VPN. 127.0.0.1 keeps a
# laptop's stack to itself. Compose refuses to start with it unset; never use 0.0.0.0. start.sh also reads
# it as the address clients reach the stack on.
BIND_ADDR=127.0.0.1

# Change every password below before a real deployment: the values shipped here are examples.

# --- TAK Server: certificate subject (used when generating the CA and certs) ---
COUNTRY_CODE=US
STATE=South Carolina
CITY=North Augusta
ORGANIZATION=blackrelay
ORGANIZATIONAL_UNIT=NA

# --- TAK Server: enrollment ---
# automated_enrollment: clients enroll with the username/password below.
# manual_enrollment: not supported by this image (CoreConfig.xml is built around the intermediate CA).
ENROLLMENT_TYPE=automated_enrollment
AUTOMATED_ADMIN_USERNAME=admin
AUTOMATED_ADMIN_PASSWORD=ChangeMe-Admin1!
AUTOMATED_CLIENT_USERNAME=user
AUTOMATED_CLIENT_PASSWORD=ChangeMe-User123!
ADMINS_COUNT=1
USER_COUNT=1

# Set both to also build an ATAK/iTAK mission package in tak-server/shared/
SERVER_NAME=
IP_OR_DOMAIN_NAME=

# --- Gateway <-> TAK TLS ---
# Password of the gateway's .p12 and of every private key the pki service makes. TAK's cert scripts
# default to "atakatak" (also hardcoded in tak-server/CoreConfig.xml); see README before changing.
TLS_PASSWORD=atakatak
TLS_DONT_CHECK_HOSTNAME=true

# TAK Server's REST API, where the gateway makes and removes each site's mission package (mutual TLS, with the
# same pytak-gateway client cert). The default reaches the takserver container; set it only to point elsewhere.
# TAK_API_URL=https://takserver:8443

# --- Gateway: mTLS on port 8000 ---
# gateway-http only accepts clients whose certificate was signed by the TAK CA (the one ATAK already holds).
# The pki service builds the CA and the gateway's server cert once; see README "Certificates and rotation".
# The server cert carries exactly one name (makeCert.sh allows one): the name or IP your clients use to reach
# the gateway. It defaults to BIND_ADDR; set it only if clients use a DNS name instead. Changing it later:
# `docker compose up -d pki`, then `docker compose exec pki /opt/configurator/pki-init.sh rotate-gateway`.
# GATEWAY_TLS_NAME=

# --- Gateway: Safe House contract (http and mqtt) ---
# Sites and their nodes live in the gateway's registry (a SQLite file on the gateway-data
# volume). Creating a site needs this admin password, so set only its Argon2id hash here:
#   pytak-gw hash-password
# and paste the output. KEEP THE SINGLE QUOTES: the hash is full of `$`, which compose would
# otherwise try to expand. With no hash, no admin route (sites, nodes, clear) can be used.
SITE_ADMIN_HASH=

# --- Gateway: Fusion (the http monitor; README, "Fusion") ---
# Set FUSION_URL and start.sh starts the http monitor. It should be https: the bearer token rides on it.
FUSION_URL=
# Set to true to allow an http:// FUSION_URL on a trusted network (the token then travels in cleartext).
FUSION_ALLOW_HTTP=
FUSION_TOKEN=
# A CA file inside the container, when Fusion's certificate is not signed by a public CA.
FUSION_CAFILE=
# Seconds between polls (it backs off when Fusion fails).
FUSION_POLL_INTERVAL=10
# Physical event types that trip a node, comma-separated. Fusion's contract names none but motion_cleared,
# so which ones are intrusions is yours to say. A zone reporting tamper always trips.
FUSION_PHYSICAL_TRIP_TYPES=tamper
# Zone kinds that also trip a node when they leave their resting state (a door opens, motion, glass breaks).
FUSION_PHYSICAL_TRIP_KINDS=contact,motion,glass_break
# Minutes a detection from a node nobody has registered yet is kept, to be raised when it is registered.
# 0 keeps none.
FUSION_HOLD_MINUTES=15

# --- Gateway: MQTT (the mqtt service and its broker; README, "MQTT") ---
MQTT_TOPIC=nodes/#
# The gateway's own broker login. The broker takes TLS on 8883 only and refuses anyone without a
# login; each node has its own login (site/subsystem/node) and may write only nodes/<its login>/.
# Leave both empty until the mqtt service is used; the gateway-mqtt service will not start without them.
MQTT_USERNAME=
MQTT_PASSWORD=
