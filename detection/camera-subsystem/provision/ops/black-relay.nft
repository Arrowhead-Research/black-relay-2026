#!/usr/sbin/nft -f
# Black Relay camera node firewall. Install as /etc/nftables.conf (nftables.service loads it).
# See README, "Firewall policy".
#
# Replaces only its own table, with no "flush ruleset", because a reload must not remove
# the table that NetworkManager owns. A drop here is final, even if another
# table's chain on the same hook accepts the packet.
# Output is not filtered: the node reaches the camera and site LAN by itself.
# Interfaces are matched by name, because wlan0 may not exist at load time.
#
# Only the central node reaches this node's services: its address is the one element of
# central_hosts. The set is declared here and its element comes from a file the portal replaces
# on each save, through a glob, so a missing or empty file means the firewall with nobody admitted.
# A damaged file fails the whole load: see README, "If nftables fails at boot".

define WIFI_IF = "wlan0"
define CAMERA_IF = "eth0"
define AP_NET = 10.42.0.0/24
define AP_IP = 10.42.0.1
define SSH_PORT = 22
# Frigate's proxy port, which holds the shared secret.
define FRIGATE_UI_PORTS = { 8971 }
# go2rtc's RTSP, which the central node pulls live view from.
define RTSP_PORT = 8554

table inet black_relay
delete table inet black_relay

table inet black_relay {
    set central_hosts {
        type ipv4_addr
    }

    chain input {
        type filter hook input priority filter; policy drop;

        # Node-local services: mosquitto, and the Frigate container under host networking.
        iifname "lo" accept

        # The broker is loopback-only. These enforce that if a listener ever widens.
        ip daddr 127.0.0.0/8 counter drop
        ip6 daddr ::1 counter drop
        meta l4proto { tcp, udp } th dport 1883 counter drop

        # IPv6 neighbor discovery on the site LAN. Ahead of the conntrack check.
        iifname $WIFI_IF icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, mld-listener-query } accept

        ct state invalid counter drop
        # Replies to what the node started, including RTSP it pulls from the camera.
        ct state established,related accept

        # The central-only rules below must not be reachable over link-local IPv6, or
        # through an address this node holds on another interface.
        iifname $WIFI_IF ip6 daddr fe80::/10 tcp dport { 22, 8554, 8971 } drop
        iifname $WIFI_IF fib daddr . iif type != { local, broadcast, multicast } drop

        # wlan0 as the setup AP: the portal, DNS and DHCP, and nothing else.
        iifname $WIFI_IF ip saddr $AP_NET ip daddr $AP_IP tcp dport 80 counter accept
        iifname $WIFI_IF ip saddr $AP_NET ip daddr $AP_IP meta l4proto { tcp, udp } th dport 53 counter accept
        iifname $WIFI_IF ip saddr { 0.0.0.0, $AP_NET } ip daddr { 255.255.255.255, $AP_IP } udp sport 68 udp dport 67 counter accept
        iifname $WIFI_IF ip saddr $AP_NET counter drop
        iifname $WIFI_IF ip daddr $AP_IP counter drop

        # wlan0 on the site LAN. AP traffic never gets here: the two rules above end it.
        iifname $WIFI_IF udp sport 67 udp dport 68 counter accept
        iifname $WIFI_IF ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept
        iifname $WIFI_IF ip daddr 224.0.0.251 udp dport 5353 accept
        iifname $WIFI_IF ip6 daddr ff02::fb udp dport 5353 accept
        iifname $WIFI_IF icmp type echo-request accept
        iifname $WIFI_IF icmpv6 type echo-request accept
        iifname $WIFI_IF ip saddr @central_hosts tcp dport $SSH_PORT counter accept
        iifname $WIFI_IF ip saddr @central_hosts tcp dport $FRIGATE_UI_PORTS counter accept
        iifname $WIFI_IF ip saddr @central_hosts tcp dport $RTSP_PORT counter accept
        iifname $WIFI_IF counter drop

        # eth0: the camera link. The node serves the camera one DHCP address, and nothing
        # else starts from this side.
        iifname $CAMERA_IF udp sport 68 udp dport 67 counter accept
        iifname $CAMERA_IF counter drop
    }

    # ipv4.method=shared turns on IP forwarding. This node routes nothing, so an AP client
    # cannot reach the camera or the site LAN. The named rules count camera
    # attempts for the field checks; the policy drops all the rest.
    chain forward {
        type filter hook forward priority filter; policy drop;

        iifname $CAMERA_IF counter drop
        oifname $CAMERA_IF counter drop
    }
}

include "/etc/black-relay/central-hosts*.nft"
