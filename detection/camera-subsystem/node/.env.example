# Copy to .env. Ansible writes it on fleet nodes.
# Owner of /etc/camerabridge/bridge.yaml (user camerabridge): id -u camerabridge, id -g camerabridge.
CAMERABRIDGE_UID=998
CAMERABRIDGE_GID=998
# Optional: run a pulled image instead of building ../ (e.g. ghcr.io/<owner>/black-relay/camera-node:latest).
# CAMERA_NODE_IMAGE=black-relay/camera-node:local
