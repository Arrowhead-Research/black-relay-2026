# Copied to .env by ./setup-credentials.sh, which fills in the secrets. Never commit .env.
# Values are in single quotes, so that no character in them means anything to compose.

# --- Your site. Required: the API will not start without it ---
# The site LAN the nodes are on. The relay sends logins and video requests only to node addresses
# inside it. It cannot overlap the two subnets at the bottom of this file.
RELAY_SITE_SUBNET=
# This host's own LAN IP, which no node may claim. Optional, and worth setting.
RELAY_CENTRAL_IP=

# --- Secrets ---
RELAY_API_TOKEN=
# The login nodes hold. MediaMTX pulls each node's video with it. The password also derives the
# Frigate proxy secret, so change it here and on every node together.
# With the shared compute node's broker, put that broker's node login here.
RELAY_BROKER_USER=
RELAY_BROKER_PASSWORD=
# The API's own broker login, which nodes do not hold.
RELAY_API_BROKER_USER=
RELAY_API_BROKER_PASSWORD=
# The API's MQTT client id. Keep it secret: a broker login with this id could take over the API's
# session. Changing it loses whatever the broker has queued for the API.
RELAY_MQTT_CLIENT_ID=
# For whoever watches video over RTSP or WebRTC. Separate from the broker's logins.
RELAY_READ_USER=
RELAY_READ_PASSWORD=
RELAY_MEDIAMTX_API_PASSWORD=

# --- The broker ---
# "broker" runs the bundled one. Leave empty to use another, and give its IP below.
COMPOSE_PROFILES=broker
RELAY_BROKER_HOST=mosquitto
RELAY_BROKER_PORT=1883

# --- Host ports ---
# A port a host service already holds makes "docker compose up" fail with "address already in
# use". Change the number here. See "Ports" in README.md for which ones nodes need unchanged.
RELAY_BIND_ADDRESS=0.0.0.0
# Empty means RELAY_BIND_ADDRESS. A host service on 127.0.0.1 clashes with a wildcard bind, so
# give the site LAN IP here to share these ports with one. Nodes only need the LAN address.
RELAY_NTP_BIND_ADDRESS=
RELAY_BROKER_BIND_ADDRESS=
RELAY_API_PORT=8080
RELAY_RTSP_PORT=8554
RELAY_WEBRTC_HTTP_PORT=8889
RELAY_WEBRTC_UDP_PORT=8189
RELAY_BROKER_PUBLISH_PORT=1883
RELAY_NTP_PORT=123

# --- WebRTC ---
# Comma-separated addresses browsers reach this host on: its site LAN IP and its Tailscale IP.
RELAY_WEBRTC_HOSTS=

# --- The bundle's own networks ---
# Change these only if a subnet is in use on the host. No node address may lie in either.
RELAY_EDGE_SUBNET=172.31.251.0/24
RELAY_CONTROL_SUBNET=172.31.250.0/29
RELAY_MEDIAMTX_CONTROL_IP=172.31.250.2
RELAY_API_CONTROL_IP=172.31.250.3
