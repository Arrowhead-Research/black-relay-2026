# Copied to .env by ./setup-credentials.sh, which fills in the secrets. Never commit .env.
# Values are in single quotes, so that no character in them means anything to compose.

# --- Secrets ---
RELAY_API_TOKEN=
# The broker's login. Nodes use the same one, and MediaMTX pulls each node's video with it. The
# password also derives the Frigate proxy secret, so change it here and on every node together.
# With the shared compute node's broker, put that broker's login here.
RELAY_BROKER_USER=
RELAY_BROKER_PASSWORD=
# For whoever watches video over RTSP or WebRTC. Separate from the broker's login.
RELAY_READ_USER=
RELAY_READ_PASSWORD=
RELAY_MEDIAMTX_API_PASSWORD=

# --- The broker ---
# "mosquitto" is the bundled one, under --profile broker. For another, give its IP.
RELAY_BROKER_HOST=mosquitto
RELAY_BROKER_PORT=1883

# --- Host ports ---
# A port a host service already holds makes "docker compose up" fail with "address already in
# use". Change the number here. See "Ports" in README.md for which ones nodes need unchanged.
RELAY_BIND_ADDRESS=0.0.0.0
# Empty means RELAY_BIND_ADDRESS. A host service on 127.0.0.1 clashes with a wildcard bind, so
# give the site LAN IP here to share these ports with one. Nodes only need the LAN address.
RELAY_NTP_BIND_ADDRESS=
RELAY_BROKER_BIND_ADDRESS=
RELAY_API_PORT=8080
RELAY_RTSP_PORT=8554
RELAY_WEBRTC_HTTP_PORT=8889
RELAY_WEBRTC_UDP_PORT=8189
RELAY_BROKER_PUBLISH_PORT=1883
RELAY_NTP_PORT=123

# --- WebRTC ---
# Comma-separated addresses browsers reach this host on: its site LAN IP and its Tailscale IP.
RELAY_WEBRTC_HOSTS=

# --- The control network ---
# Change these only if this subnet is in use on the host.
RELAY_CONTROL_SUBNET=172.31.250.0/29
RELAY_MEDIAMTX_CONTROL_IP=172.31.250.2
RELAY_API_CONTROL_IP=172.31.250.3
