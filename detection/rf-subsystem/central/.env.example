# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Host address to expose ports on: 127.0.0.1 for local dev, or this host's
# Tailscale IP for node connections over the tailnet.
BIND_ADDR=127.0.0.1

# Must match the capture helper version installed on the nodes.
KISMET_VERSION=2026-10-R1

# Seeded into Kismet on first start only (stored in the kismet-home volume).
KISMET_ADMIN_USER=admin
KISMET_ADMIN_PASSWORD=change-me

# rf-analytics (profile "analytics"): file names inside analytics/config/.
# Replace the examples with the real site layout and rules for the field site.
RF_SITE=site.wbt-nodes.example.yaml
RF_RULES=rules.wbt-live.example.yaml
RF_FRIENDLY=friendly.wbt-nodes.example.yaml
RF_TOPIC_PREFIX=detection/rf

# rf-dfviz (profile "dfviz"): host port for the heat-map page.
DFVIZ_PORT=8080
# Name of the deployment site: calibration spots, fits and walls are kept per site.
DFVIZ_SITE=default
# 1 = add synthetic BLE/Wi-Fi/TPMS emitters with known positions (testing)
DFVIZ_DEMO=
