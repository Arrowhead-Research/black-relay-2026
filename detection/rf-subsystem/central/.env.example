# Optional. Copy to .env only to change a default; .env is git-ignored, never commit real values.
# Every password is generated on first start (bootstrap.sh) and kept in the rf-secrets volume.
# On the central server (repo-root compose.yaml) the bind address comes from the root .env's
# BIND_ADDRESS and the console's broker login from BROKER_RF_USER / BROKER_RF_PASSWORD there.

# Host address to expose ports on (default: BIND_ADDRESS, else 127.0.0.1).
# BIND_ADDR=127.0.0.1

# Must match the capture helper version installed on the nodes.
# KISMET_VERSION=2026-10-R1

# Kismet admin user (password: generated). Setting KISMET_ADMIN_PASSWORD here uses it instead.
# KISMET_ADMIN_USER=admin

# rf-analytics: file names inside analytics/config/. Replace the examples with the real site
# layout and rules for the field site.
# RF_SITE=site.wbt-nodes.example.yaml
# RF_RULES=rules.wbt-live.example.yaml
# RF_FRIENDLY=friendly.wbt-nodes.example.yaml

# WBT Console. Sign-in passwords are generated; set these to choose them instead.
# CONSOLE_PORT=8080
# CONSOLE_OPERATOR_PASSWORD=
# CONSOLE_ADMIN_PASSWORD=
# Site to start on the first time (afterwards the Site menu chooses).
# CONSOLE_SITE=default
# 1 = add synthetic BLE/Wi-Fi/TPMS emitters with known positions (testing)
# CONSOLE_DEMO=

# Kismet's web UI/REST port 2501 is published on loopback only (SSH tunnel). Set an address to publish it.
# KISMET_UI_BIND=127.0.0.1
