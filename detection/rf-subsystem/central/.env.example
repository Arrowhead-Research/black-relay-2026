# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Host address to expose ports on: 127.0.0.1 for local dev, or this host's
# Tailscale IP for node connections over the tailnet.
BIND_ADDR=127.0.0.1

# Must match the capture helper version installed on the nodes.
KISMET_VERSION=2026-10-R1

# Seeded into Kismet on first start only (stored in the kismet-home volume).
KISMET_ADMIN_USER=admin
KISMET_ADMIN_PASSWORD=change-me

# rf-console (profile "console"): the WBT Console page.
CONSOLE_PORT=8080
# Sign-in. Operators watch, mark devices and set up the site; admins can also
# export, clear and wipe site data. Leave both empty to turn sign-in off (lab only).
CONSOLE_OPERATOR_PASSWORD=
CONSOLE_ADMIN_PASSWORD=
# Site to start on the first time (afterwards the Site menu chooses).
CONSOLE_SITE=default
# 1 = add synthetic BLE/Wi-Fi/TPMS emitters with known positions (testing)
CONSOLE_DEMO=
# Console publishes device positions and node status to the central broker
# (repo-root compose.yaml) with the rf-console login. ../../../setup-central.sh
# --with-rf fills these in from the root .env; empty host: publishing off.
CONSOLE_MQTT_HOST=
CONSOLE_MQTT_USER=
CONSOLE_MQTT_PASSWORD=
