#!/bin/sh
# One-time Wi-Fi diagnostics: every 30 s for 6 min, snapshot hotspot state to the boot partition.
out=/boot/firmware/rf-diag.txt
i=0
while [ $i -lt 12 ]; do
  sleep 30; i=$((i+1))
  {
    echo "=== snapshot $i  $(date -Is)  up $(cut -d' ' -f1 /proc/uptime)s"
    echo "--- cloud-init"; cloud-init status --long 2>&1 | head -20
    echo "--- rfkill"; rfkill list 2>&1
    echo "--- reg"; iw reg get 2>&1 | head -8
    echo "--- nmcli general / devices / connections"
    nmcli general 2>&1; nmcli device 2>&1; nmcli -f NAME,TYPE,DEVICE,ACTIVE,STATE connection show 2>&1
    echo "--- setup-ap (no secrets)"
    nmcli -f connection.autoconnect,802-11-wireless.mode,802-11-wireless.band,802-11-wireless.channel,802-11-wireless-security.key-mgmt,802-11-wireless-security.proto,802-11-wireless-security.pairwise,802-11-wireless-security.group,802-11-wireless-security.pmf,ipv4.method,ipv4.addresses,GENERAL.STATE connection show setup-ap 2>&1
    echo "--- iw"; iw dev 2>&1; iw dev wlan0 station dump 2>&1
    echo "--- ip"; ip -4 addr 2>&1; ip route 2>&1
    echo "--- dnsmasq"; ps -eo pid,args | grep -i [d]nsmasq
    echo "--- dmesg (wifi)"; dmesg 2>&1 | grep -iE 'brcm|wlan|cfg80211|ieee80211' | tail -60
    echo "--- journal NetworkManager / wpa_supplicant"
    journalctl -b --no-pager -o short-monotonic -u NetworkManager -u wpa_supplicant 2>&1 | tail -400
    echo "--- journal fallback / cloud-init errors"
    journalctl -b --no-pager -u rf-wifi-fallback 2>&1 | tail -30
    journalctl -b --no-pager -p warning 2>&1 | tail -60
  } > "$out.tmp" 2>&1
  mv "$out.tmp" "$out"; sync
done
echo "=== done $(date -Is)" >> "$out"; sync
