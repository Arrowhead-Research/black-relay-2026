# Copy to fleet.env (gitignored) and edit. No secrets here: the Wi-Fi passphrase is asked for when you
# flash (or set WIFI_PASSWORD in your shell).

# Login user created on every node; Ansible connects as this user with the key below.
ADMIN_USER=pi
# Fleet SSH key pair. Created on first use if missing; only the .pub half is written to cards.
SSH_KEY=$HOME/.ssh/blackrelay_fleet

TIMEZONE=America/Chicago
WIFI_COUNTRY=US
# Setup network for staging: SETUP_HUB hosts it as a hotspot (10.42.0.1, sharing its Ethernet if
# plugged in), every other node joins it, and each node opens its own "<node>-setup" rescue hotspot
# after 3 minutes offline. Its passphrase is asked for when you flash (or SETUP_PASSWORD).
# Empty: no hub, no rescue hotspots.
SETUP_SSID=BlackRelay-Setup
SETUP_HUB=wbt-1

# A network the nodes should join straight away (optional). Leave empty for Ethernet only. Onboard Wi-Fi (wlan0) is the backhaul then; capture uses the external adapter.
WIFI_SSID=

# Raspberry Pi OS Lite (64-bit). The default follows the latest release; pin a dated .img.xz URL to make
# every card identical (its .sha256 is checked either way).
# IMAGE_URL=https://downloads.raspberrypi.com/raspios_lite_arm64/images/<dated dir>/<file>.img.xz

# Provision without SSH to the central server: the file holding the output of
# detection/central/rf-node-secrets.sh, run by hand on the central server (see README). Keep it 0600.
# CENTRAL_SECRETS=rf-node-secrets
