# Example environment for Kismet remote-capture systemd units.
# Copy to /etc/rf-node/rf-node.env on the node and edit. No secrets.
# Central Kismet server (reachable from the node, e.g. MagicDNS name or LAN IP).
CENTRAL_HOST=rf-central
CENTRAL_PORT=3501

# Node/source naming (appears in Kismet). Use a unique node ID per WBT node.
NODE_NAME=rf-node-01

# Capture interfaces/devices (VERIFY per node before enabling).
# Do NOT set WIFI_IFACE to the backhaul/SSH interface (e.g. onboard wlan0).
WIFI_IFACE=wlan1
WIFI_SOURCE_OPTS=

# Bluetooth adapter. hci numbering depends on enumeration order (hci0 can be
# the onboard radio on one node and the USB dongle on another), so choose by
# what the adapter is. First match wins:
#   BT_ADDR   exact adapter address (see: ls /sys/class/bluetooth; cat .../address)
#   BT_PREFER usb | onboard
#   BT_IFACE  index fallback
BT_ADDR=
BT_PREFER=usb
BT_IFACE=hci0
BT_SOURCE_OPTS=

RTL_SOURCE=rtl433-0
RTL_SOURCE_OPTS=
