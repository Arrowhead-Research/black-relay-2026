# Generate a token with: openssl rand -hex 32
FUSION_API_TOKEN=
# Camera relay credentials with read access to the three detection/camera topics.
# Use a client id of fusion's own, not the relay API's persistent-session client id.
FUSION_CAMERA_MQTT_USER=
FUSION_CAMERA_MQTT_PASSWORD=
FUSION_API_PORT=8090
FUSION_BIND_ADDRESS=127.0.0.1
# Host path Compose mounts at /config/config.yaml. The process itself reads FUSION_CONFIG.
FUSION_CONFIG_FILE=./config.yaml
FUSION_NETWORK_NAME=fusion
