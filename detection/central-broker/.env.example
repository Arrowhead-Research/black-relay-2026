# Copy of the names setup-credentials.sh writes to .env; run that script instead of filling this in.
# The central node's address on the Detection network. The broker binds to this address only.
BROKER_BIND_ADDRESS=
BROKER_PORT=1883
# One credential per client. Publishers may only write under their own prefix (aclfile).
BROKER_FUSION_USER=fusion
BROKER_FUSION_PASSWORD=
BROKER_PHYSICAL_USER=physical-subsystem
BROKER_PHYSICAL_PASSWORD=
BROKER_RF_USER=rf-console
BROKER_RF_PASSWORD=
# Camera kits share this login; its password is typed into each kit's setup page.
BROKER_CAMERA_USER=relay
BROKER_CAMERA_PASSWORD=
