# Copy to .env (never committed), fill in, then: docker compose up -d   (see scripts/bootstrap.sh)
# This machine's name: lowercase letters, digits, dashes. Jayden seals the panel pairing under this name.
DEVICE=alex-bridge
# The IQ5 panel's address.
PANEL_IP=192.168.1.50
# Addresses this machine is reached at (for its local broker and API certificates), space separated.
BRIDGE_HOSTS=127.0.0.1
# GitHub user + classic token with read:packages, to fetch the sealed pairing from ghcr.io.
REGISTRY_USER=
REGISTRY_TOKEN=
# Optional: the Ethernet pairing instead of the Wi-Fi one.
# PAIRING_BUNDLE=eth
# Optional: send events to the central broker (BROKER_PHYSICAL_PASSWORD from the central server), then
# set fusion.enabled: true in config/config.yaml and start with --profile fusion.
# FUSION_PASSWORD=
