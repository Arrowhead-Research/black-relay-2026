# cp .env.example .env; never commit .env.

# The kits' WiFi subnet. MediaMTX may dial TCP 8554 inside it and nowhere else. Required.
RELAY_SITE_SUBNET=
# This host's address, which the kits also know as their broker address. Everything binds to it.
RELAY_CENTRAL_IP=
RELAY_BIND_ADDRESS=
# Addresses browsers reach this host on, comma-separated (the LAN address, and a tailnet one).
RELAY_WEBRTC_HOSTS=

# The kits' broker login, BROKER_CAMERA_USER/PASSWORD on the central broker. MediaMTX pulls
# each kit's RTSP with it; the kit's go2rtc checks it.
RELAY_CAMERA_USER=relay
RELAY_CAMERA_PASSWORD=
# For whoever watches video. 8-63 printable ASCII, not starting with sha256: or argon2:.
RELAY_READ_USER=viewer
RELAY_READ_PASSWORD=

RELAY_RTSP_PORT=8554
RELAY_WEBRTC_HTTP_PORT=8889
RELAY_WEBRTC_UDP_PORT=8189
RELAY_NTP_PORT=123
