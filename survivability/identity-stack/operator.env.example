# Variable names only. Copy this file outside the repository on a trusted
# operator workstation, set mode 0600, and populate it there. Never source a
# populated copy inside Pi or commit it.

# Packer and OpenTofu access to the Hetzner project.
HCLOUD_TOKEN=

# OpenTofu Cloudflare DNS access. Scope the token to the managed zone.
CLOUDFLARE_API_TOKEN=

# Backblaze B2 S3-compatible state backend. Use a bucket-scoped application key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# OpenTofu client-side state encryption, BX11 creation, and the backup
# subaccount. Map these at runtime to TF_VAR_state_passphrase,
# TF_VAR_storage_box_password, and TF_VAR_storage_box_subaccount_password.
TOFU_STATE_PASSPHRASE=
STORAGE_BOX_PASSWORD=
STORAGE_BOX_SUBACCOUNT_PASSWORD=

# SOPS and Ansible remain operator-only. ANSIBLE_INVENTORY is the absolute path
# to the external mode-0600 production-hosts.yml created from hosts.example.yml.
SOPS_AGE_KEY_FILE=
ANSIBLE_INVENTORY=
