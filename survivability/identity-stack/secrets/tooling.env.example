# Variable names only. Never populate this tracked file.
#
# The real values live in secrets/tooling.sops.env, encrypted with SOPS to the
# age recipients in .sops.yaml and committed as ciphertext. Create or edit it
# from a trusted operator workstation:
#
#   sops secrets/tooling.sops.env
#
# Names here are the names the tools actually read, so no aliasing step is
# needed. See docs/runbooks/secrets.md.

# Packer and OpenTofu access to the Hetzner project.
HCLOUD_TOKEN=

# OpenTofu Cloudflare DNS access. Scope the token to the managed zone.
CLOUDFLARE_API_TOKEN=

# Backblaze B2 S3-compatible state backend. Use a bucket-scoped application key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# OpenTofu client-side state encryption, BX11 creation, and the backup
# subaccount. OpenTofu reads TF_VAR_* directly.
TF_VAR_state_passphrase=
TF_VAR_storage_box_password=
TF_VAR_storage_box_subaccount_password=
