APP_URL=https://{{ pocket_id_domain }}
TRUST_PROXY=true
PUID={{ identity_stack_pocket_id_uid }}
PGID={{ identity_stack_pocket_id_gid }}
ENCRYPTION_KEY={{ pocket_id_encryption_key }}
UI_CONFIG_DISABLED=true
APP_NAME={{ identity_stack_pocket_id_app_name }}
ALLOW_USER_SIGNUPS=disabled
ALLOW_OWN_ACCOUNT_EDIT=false
REQUIRE_USER_EMAIL=true
EMAILS_VERIFIED=true
{# Pinned off unconditionally, including when SMTP is disabled. Enabling it
   would let anyone at the sign-in page name a username and have a working
   login code mailed out, which is a standing passkey bypass for every account
   gated only on a mailbox. It would silently defeat WEBAUTHN_USER_VERIFICATION
   below. The admin-triggered variant is the supported onboarding path. #}
EMAIL_ONE_TIME_ACCESS_AS_UNAUTHENTICATED_ENABLED=false
{% if identity_stack_pocket_id_smtp_enabled %}
SMTP_HOST={{ identity_stack_pocket_id_smtp_host }}
SMTP_PORT={{ identity_stack_pocket_id_smtp_port }}
SMTP_TLS={{ identity_stack_pocket_id_smtp_tls }}
SMTP_SKIP_CERT_VERIFY=false
SMTP_USER={{ pocket_id_smtp_username }}
SMTP_PASSWORD={{ pocket_id_smtp_password }}
SMTP_FROM={{ pocket_id_smtp_from }}
EMAIL_ONE_TIME_ACCESS_AS_ADMIN_ENABLED=true
{% if identity_stack_pocket_id_email_login_notification %}
EMAIL_LOGIN_NOTIFICATION_ENABLED=true
{% else %}
EMAIL_LOGIN_NOTIFICATION_ENABLED=false
{% endif %}
{% endif %}
LDAP_ENABLED=true
LDAP_URL=ldap://lldap:3890
LDAP_BIND_DN=uid={{ identity_stack_pocket_id_bind_username }},ou=people,{{ lldap_base_dn }}
LDAP_BIND_PASSWORD={{ lldap_pocket_id_bind_password }}
LDAP_BASE={{ lldap_base_dn }}
LDAP_USER_SEARCH_FILTER=(&(objectClass=person)(memberOf=cn={{ identity_stack_membership_group }},ou=groups,{{ lldap_base_dn }})(!(uid={{ identity_stack_pocket_id_bind_username }})))
LDAP_USER_GROUP_SEARCH_FILTER=(objectClass=groupOfNames)
LDAP_SKIP_CERT_VERIFY=false
LDAP_ATTRIBUTE_USER_UNIQUE_IDENTIFIER=uuid
LDAP_ATTRIBUTE_USER_USERNAME=uid
LDAP_ATTRIBUTE_USER_EMAIL=mail
LDAP_ATTRIBUTE_USER_FIRST_NAME=givenName
LDAP_ATTRIBUTE_USER_LAST_NAME=sn
LDAP_ATTRIBUTE_USER_DISPLAY_NAME=displayName
LDAP_ATTRIBUTE_USER_PROFILE_PICTURE=jpegPhoto
LDAP_ATTRIBUTE_GROUP_MEMBER=member
LDAP_ATTRIBUTE_GROUP_UNIQUE_IDENTIFIER=uuid
LDAP_ATTRIBUTE_GROUP_NAME=cn
LDAP_ADMIN_GROUP_NAME={{ identity_stack_pocket_id_admin_group }}
LDAP_SOFT_DELETE_USERS=true
WEBAUTHN_USER_VERIFICATION=required
